    connect(btn.Activated, function()
        btn.BackgroundColor3 = THEME.accent
        tween(btn, {BackgroundColor3 = THEME.hover}, 0.3)
        pcall(callback)
    end)
    return btn
end

-- segmented selector: options = {{label, value}, ...}
local function addSegment(options, current, callback)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = THEME.item,
        BorderSizePixel = 0,
        LayoutOrder = nextOrder(),
    }, page)
    corner(row, 8)
    new("UIPadding", {
        PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
        PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
    }, row)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, row)

    local buttons = {}
    local function render(value)
        for _, b in ipairs(buttons) do
            local on = b.value == value
            tween(b.btn, {BackgroundColor3 = on and THEME.accent or THEME.bg}, 0.15)
            b.btn.TextColor3 = on and Color3.new(1, 1, 1) or THEME.dim
        end
    end

    local width = 1 / #options
    for i, opt in ipairs(options) do
        local btn = new("TextButton", {
            Size = UDim2.new(width, -4 * (#options - 1) / #options, 1, 0),
            BackgroundColor3 = THEME.bg,
            AutoButtonColor = false,
            Text = opt[1],
            Font = Enum.Font.GothamBold,
            TextSize = 13,
            TextColor3 = THEME.dim,
            LayoutOrder = i,
        }, row)
        corner(btn, 6)
        table.insert(buttons, {btn = btn, value = opt[2]})
        connect(btn.Activated, function()
            render(opt[2])
            pcall(callback, opt[2])
        end)
    end
    render(current)
end

-- slider row; the page stops scrolling while the slider is dragged (touch)
local function addSlider(text, minV, maxV, default, onChange, onDone)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundColor3 = THEME.item,
        BorderSizePixel = 0,
        LayoutOrder = nextOrder(),
    }, page)
    corner(row, 8)

    new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 4),
        Size = UDim2.new(1, -90, 0, 22),
        Font = Enum.Font.GothamMedium,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = THEME.text,
        Text = text,
    }, row)
    local valLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -74, 0, 4),
        Size = UDim2.fromOffset(60, 22),
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextColor3 = THEME.accent2,
        Text = "",
    }, row)

    local track = new("Frame", {
        Position = UDim2.fromOffset(14, 36),
        Size = UDim2.new(1, -28, 0, 8),
        BackgroundColor3 = THEME.off,
        BorderSizePixel = 0,
        Active = true,
    }, row)
    corner(track, 4)
    local fill = new("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = THEME.accent,
        BorderSizePixel = 0,
    }, track)
    corner(fill, 4)
    local knob = new("Frame", {
        Size = UDim2.fromOffset(18, 18),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, track)
    corner(knob, 9)

    local function setValue(v)
        v = math.clamp(math.floor(v + 0.5), minV, maxV)
        local a = (v - minV) / (maxV - minV)
        fill.Size = UDim2.fromScale(a, 1)
        knob.Position = UDim2.fromScale(a, 0.5)
        valLabel.Text = tostring(v)
        return v
    end
    setValue(default)

    local dragging = false
    local function fromInput(input)
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        local a = math.clamp((input.Position.X - track.AbsolutePosition.X) / w, 0, 1)
        local v = setValue(minV + a * (maxV - minV))
        pcall(onChange, v)
    end

    connect(track.InputBegan, function(input)
        if isPointer(input) then
            dragging = true
            page.ScrollingEnabled = false
            fromInput(input)
        end
    end)
    connect(UserInputService.InputChanged, function(input)
        if dragging and isMove(input) then
            fromInput(input)
        end
    end)
    connect(UserInputService.InputEnded, function(input)
        if dragging and isPointer(input) then
            dragging = false
            page.ScrollingEnabled = true
            if onDone then pcall(onDone) end
        end
    end)
end

